# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Instagram Bot Account (compte utilise par le bot pour scraper)
INSTAGRAM_USERNAME=your_ig_bot_account
INSTAGRAM_PASSWORD=your_ig_bot_password

# Instagram Proxy (optionnel mais recommande)
INSTAGRAM_PROXY=

# Database
DATABASE_PATH=data/bot.db

# Gamification
ETOILES_PER_FOLLOW_GIVEN=3
ETOILES_PER_FOLLOW_RECEIVED=1
ETOILES_PER_REFERRAL=10
ETOILES_REFERRAL_FIRST_MISSION=5
ETOILES_DAILY_LOGIN=2
ETOILES_STREAK_7_DAYS=15
ETOILES_WELCOME_BONUS=5
AUTO_MODE_COST=50
AUTO_MODE_DURATION_HOURS=24
MISSION_SIZE=5

# Rate Limiting
INSTAGRAM_REQUEST_DELAY_MIN=5
INSTAGRAM_REQUEST_DELAY_MAX=15
MAX_VERIFICATIONS_PER_HOUR=20

# Admin
ADMIN_TELEGRAM_IDS=
